# Database (Neon PostgreSQL)
# DATABASE_URL: usa la conexión con pooler (host con "-pooler") — recomendada para la app.
# DIRECT_URL: usa la conexión directa (host SIN "-pooler") — requerida por Prisma para migraciones.
# Ambas las ves en Neon → Dashboard → tu proyecto → Connect.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# LLM Providers
ANTHROPIC_API_KEY="sk-ant-..."
DEEPSEEK_API_KEY="sk-..."
ZHIPU_API_KEY="..."

# Restringe qué proveedores usa la app. P.ej. ALLOWED_PROVIDERS=deepseek
# usa SOLO DeepSeek y evita que el fallback intente Claude/GLM.
# Sin esta variable se usan todos los que tengan clave.
ALLOWED_PROVIDERS="deepseek"

# Web search for the market investigator.
# Serper (serper.dev, plan gratis) funciona desde más regiones; Tavily (tavily.com)
# puede estar geo-bloqueado en algunos países. Basta con configurar UNA de las dos.
SERPER_API_KEY="..."      # https://serper.dev → crea la key gratis
TAVILY_API_KEY="tvly-..." # alternativa si tu región permite Tavily

# Override individual agent models (optional, e.g. JUEZ_MODEL=claude-opus-4-8)

# ─── Notas Neon (plan gratuito) ──────────────────────────────────────────────
# El autosuspend (~5 min) es obligatorio en el plan gratis. La app ya reintenta
# las conexiones (lib/db-retry.ts) para tolerar el "despertar".
# Si quieres cero interrupciones mientras desarrollas, corre en otra terminal:
#   pnpm warm        # ping cada 4 min hasta Ctrl+C (NO lo dejes 24/7: gasta horas de cómputo)
#   pnpm warm:once   # un solo ping (útil para despertar al instante)
